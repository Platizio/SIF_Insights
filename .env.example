# ------------------------------------------------------------------
# Lead delivery — consultation form and the lead popup.
#
# Copy to `.env.local` for local work; set the same three in Vercel
# (Project → Settings → Environment Variables) for previews and prod.
#
# All three are read ON THE SERVER ONLY, by the lead-delivery module.
# Never prefix them with NEXT_PUBLIC_: that would inline the API key
# into the JavaScript every visitor downloads.
#
# Leave RESEND_API_KEY empty and the forms say so honestly — they show
# the direct channels (phone, WhatsApp, email) instead of pretending an
# enquiry was sent. An unset key must never look like a successful send.
# ------------------------------------------------------------------

# Resend API key (https://resend.com/api-keys). Sending access only.
RESEND_API_KEY=

# The From: address. Must be on a domain verified in Resend — e.g.
# leads@sifinsight.com once the DNS records are in place. Resend
# rejects any other sender.
LEAD_FROM_EMAIL=

# Where enquiries land. The canonical inbox (lib/site.ts SITE.email).
LEAD_TO_EMAIL=sifinsights@gmail.com
